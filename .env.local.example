# Turso Database Configuration (Production)
# For local development, these can be omitted to use local SQLite file
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-auth-token

# Authentication
# Secret key for signing session cookies.
# Generate a random string (e.g. `openssl rand -base64 32`)
SESSION_SECRET=your_session_secret_here

# Default Users (First Run Only)
# Password for default users 'gary' and 'catherine'
DEFAULT_PASSWORD=changeme
